<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    AFK Realm for Windows and Linux: a local web server with the page in the browser (or an app window).
    The logic of the server tools is shared with the classic Windows build (../src); only the files without
    a WinForms window are compiled here. The page itself is in wwwroot and goes into the exe.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- WinExe: no empty console window next to the window of AFK Realm on Windows (Program.ConsoleIfNeeded
         attaches one for the command line). Linux does not know the difference. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>AFK-Realm</AssemblyName>
    <Product>AFK Realm</Product>
    <Version>1.3.36</Version>
    <!-- The web SDK turns on the server garbage collector: one heap per CPU core that keeps what it once held.
         After a map extraction or a client patch AFK Realm then sat at 8-10 GB doing nothing. The workstation
         collector with DATAS gives memory back. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RootNamespace>CoAInstaller</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DefineConstants>$(DefineConstants);AFK_WEB</DefineConstants>
    <NoWarn>$(NoWarn);CA1416;SYSLIB0014;SYSLIB0021;SYSLIB0023;SYSLIB0001;CS0618;CS0168;CS0219;CS0649;CS0414;CS8632</NoWarn>
    <ApplicationIcon>../assets/afk-realm.ico</ApplicationIcon>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <GenerateEmbeddedFilesManifest>false</GenerateEmbeddedFilesManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/AccountTransfer.cs;../src/AdminLink.cs;../src/BackupSettings.cs;../src/ClientAddons.cs;../src/ClientBinaryPatch.cs;../src/ClientDownload.cs;../src/ClientPatch.cs;../src/ClientRaces.cs;../src/ClientVoices.cs;../src/CoaCustom.cs;../src/CoaDelta.cs;../src/Coa64HdPatch.cs;../src/CoaSetup.cs;../src/CoaUninstall.cs;../src/ConfigModel.cs;../src/Core.cs;../src/Dxvk.cs;../src/Engine.cs;../src/GameLaunch.cs;../src/EsteriaSkinTint.cs;../src/EsteriaTables.cs;../src/EsteriaServer.cs;../src/GameData.cs;../src/Lang.cs;../src/ModuleBots.cs;../src/ModuleCatalog.cs;../src/Mpq.cs;../src/NativeHd.cs;../src/RaceImport.cs;../src/RaceCheck.cs;../src/RaceRepair.cs;../src/RacePacker.cs;../src/ScheduledRestart.cs;../src/ServerPresets.cs;../src/ServerRacials.cs;../src/ServerSpellDbc.cs;../src/SupportBundle.cs;../src/TextureFill.cs;../src/UpdateCheck.cs;../src/UpdatePlan.cs" />
    <EmbeddedResource Include="../engine/engine.ps1" LogicalName="CoAInstaller.engine.ps1" />
    <EmbeddedResource Include="../engine/account-transfer.sql" LogicalName="CoAInstaller.account-transfer.sql" />
    <EmbeddedResource Include="../engine/module-journal.sql" LogicalName="CoAInstaller.module-journal.sql" />
    <EmbeddedResource Include="../engine/patches/*.patch" LogicalName="CoAInstaller.engine.patches.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../engine/patches-esteria/*.patch" LogicalName="CoAInstaller.engine.patches-esteria.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../engine/patches-wowdecomp/*.patch" LogicalName="CoAInstaller.engine.patches-wowdecomp.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../assets/dxvk/dxvk-x64.zip" LogicalName="CoAInstaller.dxvk.zip" />
    <EmbeddedResource Include="../assets/dungeon-clear-addon/DungeonClear.zip" LogicalName="CoAInstaller.dungeonclear.zip" />
    <EmbeddedResource Include="../assets/bot-map-tools.zip" LogicalName="CoAInstaller.botmaps.zip" />
    <EmbeddedResource Include="../assets/afk-realm-header.png" LogicalName="CoAInstaller.logo.png" />
    <EmbeddedResource Include="../lang/*.json" LogicalName="CoAInstaller.lang.%(Filename)%(Extension)" />
    <EmbeddedResource Include="wwwroot/**/*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
</Project>
