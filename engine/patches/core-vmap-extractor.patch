+static bool ShouldSkipMap(uint32 id)
+{
+    char const* setting = getenv("AFK_VMAP_SKIP_MAPS");
+    if (!setting)
+        return id == 1727 || id == 1730 || id == 1731;
+
+    std::string const list(setting);
+    std::size_t start = 0;
+    while (start <= list.size())
+    {
+        std::size_t const end = list.find_first_of(",; ", start);
+        std::string const value = list.substr(start, end == std::string::npos ? std::string::npos : end - start);
+        if (!value.empty() && strtoul(value.c_str(), nullptr, 10) == id)
+            return true;
+        if (end == std::string::npos)
+            break;
+        start = end + 1;
+    }
+    return false;
+}
