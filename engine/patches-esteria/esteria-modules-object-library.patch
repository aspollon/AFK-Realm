@@ -78,8 +78,11 @@ endfunction()
 
 function(CopyModuleConfig configDir)
   set(postPath "configs/modules")
+  # AFK Realm: an OBJECT library (modules, see modules/CMakeLists.txt) cannot have POST_BUILD steps. The copy into
