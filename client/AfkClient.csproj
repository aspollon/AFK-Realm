<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AFK-Client</AssemblyName>
    <RootNamespace>AfkClient</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../app/wwwroot/assets/afk-realm-background.jpg" LogicalName="AfkClient.background.jpg" />
    <EmbeddedResource Include="../app/wwwroot/icon.png" LogicalName="AfkClient.icon.png" />
    <EmbeddedResource Include="ui/index.html" LogicalName="AfkClient.ui.index.html" />
    <EmbeddedResource Include="ui/app.css" LogicalName="AfkClient.ui.app.css" />
    <EmbeddedResource Include="ui/app.js" LogicalName="AfkClient.ui.app.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
</Project>
