<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    AFK Realm for Windows and Linux: a local web server with the page in the browser (or an app window).
    The logic of the server tools is shared with the classic Windows build (../src); only the files without
    a WinForms window are compiled here. The page itself is in wwwroot and goes into the exe.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- WinExe: no empty console window next to the window of AFK Realm on Windows (Program.ConsoleIfNeeded
         attaches one for the command line). Linux does not know the difference. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>AFK-Realm</AssemblyName>
    <Product>AFK Realm</Product>
    <Version>1.1.13</Version>
    <RootNamespace>CoAInstaller</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DefineConstants>$(DefineConstants);AFK_WEB</DefineConstants>
    <NoWarn>$(NoWarn);CA1416;SYSLIB0014;SYSLIB0021;SYSLIB0023;SYSLIB0001;CS0618;CS0168;CS0219;CS0649;CS0414;CS8632</NoWarn>
    <ApplicationIcon>../assets/afk-realm.ico</ApplicationIcon>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <GenerateEmbeddedFilesManifest>false</GenerateEmbeddedFilesManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/AccountTransfer.cs;../src/AdminLink.cs;../src/BackupSettings.cs;../src/ClientAddons.cs;../src/ClientBinaryPatch.cs;../src/ClientDownload.cs;../src/ClientPatch.cs;../src/ClientRaces.cs;../src/CoaCustom.cs;../src/ConfigModel.cs;../src/Core.cs;../src/Engine.cs;../src/GameData.cs;../src/Lang.cs;../src/ModuleBots.cs;../src/ModuleCatalog.cs;../src/Mpq.cs;../src/RaceImport.cs;../src/RaceCheck.cs;../src/RaceRepair.cs;../src/RacePacker.cs;../src/ScheduledRestart.cs;../src/ServerRacials.cs;../src/SupportBundle.cs;../src/UpdateCheck.cs" />
    <EmbeddedResource Include="../engine/engine.ps1" LogicalName="CoAInstaller.engine.ps1" />
    <EmbeddedResource Include="../engine/account-transfer.sql" LogicalName="CoAInstaller.account-transfer.sql" />
    <EmbeddedResource Include="../engine/module-journal.sql" LogicalName="CoAInstaller.module-journal.sql" />
    <EmbeddedResource Include="../assets/afk-realm-header.png" LogicalName="CoAInstaller.logo.png" />
    <EmbeddedResource Include="../lang/*.json" LogicalName="CoAInstaller.lang.%(Filename)%(Extension)" />
    <EmbeddedResource Include="wwwroot/**/*" LogicalName="web/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
